<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X 自动滚动长截图"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="支持无障碍自动滚动避让截屏，或手动批量导入连续截屏智能拼长图"
            android:textColor="#A1A1AA"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="开启无障碍滚动服务" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="授予悬浮窗权限" />

        <TextView
            android:id="@+id/tvBottomCropValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="底部避让高度: 260 px (推荐 X 设为 260px)"
            android:textColor="#D4D4D8"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekBottomCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:max="500"
            android:progress="260" />

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#1D9BF0"
            android:text="启动悬浮控制球（自动滚截）"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnManualStitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#00BA7C"
            android:text="批量导入连续截屏拼长图"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
